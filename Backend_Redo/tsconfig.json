{
  "compilerOptions": {
    "rootDir": "./src",
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"]
  }
}
